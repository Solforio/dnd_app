rules_version = '2';

// Private data: every user reads and writes only their own documents.
// Parties (Phase 3): readable by members only; joining works through a join
// code checked here, because Cloud Functions are not available on Spark.
// Everything not matched below is denied.
//
// Cost note: exists()/get() calls in these rules can count as document reads.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function usernameMatchesEmail(username) {
      return request.auth.token.email == username + '@dnd.local';
    }

    function partyPath(pid) {
      return /databases/$(database)/documents/parties/$(pid);
    }

    function memberPath(pid, uid) {
      return /databases/$(database)/documents/parties/$(pid)/members/$(uid);
    }

    function codePath(code) {
      return /databases/$(database)/documents/partyCodes/$(code);
    }

    function isMember(pid) {
      return signedIn() && exists(memberPath(pid, request.auth.uid));
    }

    /** True when the caller owns the party as it was before this request. */
    function isPartyOwner(pid) {
      return signedIn() && get(partyPath(pid)).data.ownerUid == request.auth.uid;
    }

    function shortString(v, max) {
      return v is string && v.size() <= max;
    }

    match /users/{uid} {
      function validUser(data) {
        return data.keys().hasOnly(['schemaVersion', 'username', 'activeCharacterId', 'createdAt'])
          && data.schemaVersion is int
          && data.username is string
          && (data.activeCharacterId == null || data.activeCharacterId is string)
          && data.createdAt is int;
      }

      allow read, delete: if isOwner(uid);
      // The username must match the synthetic sign-in email, so nobody can claim another name.
      allow create: if isOwner(uid)
        && validUser(request.resource.data)
        && usernameMatchesEmail(request.resource.data.username);
      allow update: if isOwner(uid)
        && validUser(request.resource.data)
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt;

      match /characters/{characterId} {
        function validCharacter(data) {
          return data.id == characterId
            && data.schemaVersion is int
            && data.name is string
            && data.updatedAt is int;
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCharacter(request.resource.data);
      }

      // Character pictures: small base64 images, kept apart from the character document.
      match /portraits/{characterId} {
        function validImage(v, max) {
          return v == null || (v is string && v.size() <= max && v.matches('data:image/(jpeg|png|webp);base64,.*'));
        }

        function validPortraits(data) {
          return data.keys().hasOnly(['schemaVersion', 'portrait', 'body', 'updatedAt'])
            && data.schemaVersion is int
            && validImage(data.get('portrait', null), 60000)
            && validImage(data.get('body', null), 220000)
            && data.updatedAt is int;
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPortraits(request.resource.data);
      }

      // The user's own copy of a map image, cut into chunks (no Cloud Storage on Spark). Owner only, never shared.
      match /mapImages/{fingerprint} {
        function validImageMeta(data) {
          return data.keys().hasOnly(['schemaVersion', 'width', 'height', 'fileName', 'type', 'chunks', 'updatedAt'])
            && data.schemaVersion is int
            && fingerprint.size() == 32
            && data.width is int && data.width > 0 && data.width <= 20000
            && data.height is int && data.height > 0 && data.height <= 20000
            && shortString(data.fileName, 120)
            && data.type in ['image/jpeg', 'image/png', 'image/webp']
            && data.chunks is int && data.chunks >= 1 && data.chunks <= 8
            && data.updatedAt is int;
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validImageMeta(request.resource.data);

        match /chunks/{n} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && request.resource.data.keys().hasOnly(['data'])
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 750000
            && n.matches('[0-7]');
        }
      }

      // Private list of "my parties", so the app needs no collection-group query.
      match /memberships/{pid} {
        function validMembership(data) {
          return data.keys().hasOnly(['schemaVersion', 'partyId', 'name', 'role', 'characterId', 'sharing', 'joinedAt'])
            && data.schemaVersion is int
            && data.partyId == pid
            && shortString(data.name, 60)
            && data.role in ['dm', 'player']
            && shortString(data.characterId, 64)
            && data.sharing is map
            && data.joinedAt is int;
        }

        allow read, delete: if isOwner(uid);
        // Created in the same batch as the member document.
        allow create: if isOwner(uid)
          && validMembership(request.resource.data)
          && existsAfter(memberPath(pid, uid));
        allow update: if isOwner(uid) && validMembership(request.resource.data);
      }

      // Personal maps: the image stays in the browser; pins live inside the document.
      match /maps/{mapId} {
        function validPersonalMap(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'name', 'parentId', 'fingerprint', 'width', 'height', 'pins', 'createdAt', 'updatedAt'])
            && data.schemaVersion is int
            && shortString(data.name, 60)
            && (data.parentId == null || shortString(data.parentId, 64))
            && data.fingerprint is string && data.fingerprint.size() == 32
            && data.width is int && data.height is int
            && data.pins is list && data.pins.size() <= 300
            && data.createdAt is int
            && data.updatedAt is int;
        }

        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validPersonalMap(request.resource.data);
      }
    }

    // A code reveals its party id; codes cannot be listed, and 8 characters
    // from a 31-letter alphabet make guessing impractical.
    match /partyCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['partyId'])
        && getAfter(partyPath(request.resource.data.partyId)).data.ownerUid == request.auth.uid
        && getAfter(partyPath(request.resource.data.partyId)).data.joinCode == code;
      allow delete: if isPartyOwner(resource.data.partyId);
    }

    match /parties/{pid} {
      function validParty(data) {
        return data.keys().hasOnly([
            'schemaVersion', 'name', 'campaignName', 'ownerUid', 'joinCode', 'joinEnabled',
            'currentLocation', 'nextSession', 'createdAt', 'updatedAt'])
          && data.schemaVersion is int
          && shortString(data.name, 60) && data.name.size() > 0
          && shortString(data.campaignName, 80)
          && data.ownerUid is string
          && data.joinCode is string && data.joinCode.size() == 8
          && data.joinEnabled is bool
          && shortString(data.currentLocation, 80)
          && (data.nextSession == null || (data.nextSession is map
            && data.nextSession.keys().hasOnly(['at', 'place', 'note'])
            && data.nextSession.at is int
            && shortString(data.nextSession.place, 120)
            && shortString(data.nextSession.note, 500)))
          && data.createdAt is int
          && data.updatedAt is int;
      }

      allow get: if isMember(pid);
      allow list: if false;

      // One batch: party + its code + the creator's member document (as DM) + membership.
      allow create: if signedIn()
        && validParty(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(memberPath(pid, request.auth.uid)).data.role == 'dm'
        && existsAfter(codePath(request.resource.data.joinCode));

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && validParty(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        // Ownership moves only to an existing member, with both roles swapped in the same batch.
        && (request.resource.data.ownerUid == resource.data.ownerUid
          || (getAfter(memberPath(pid, request.resource.data.ownerUid)).data.role == 'dm'
            && getAfter(memberPath(pid, request.auth.uid)).data.role == 'player'))
        // A new code replaces the old one in the same batch.
        && (request.resource.data.joinCode == resource.data.joinCode
          || (existsAfter(codePath(request.resource.data.joinCode))
            && !existsAfter(codePath(resource.data.joinCode))));

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /members/{uid} {
        function validMember(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'username', 'role', 'characterId', 'summary', 'sharing',
              'joinCode', 'joinedAt', 'updatedAt'])
            && data.schemaVersion is int
            && data.username is string
            && data.role in ['dm', 'player']
            && shortString(data.characterId, 64)
            && data.summary is map && data.summary.size() <= 20
            && data.sharing is map && data.sharing.size() <= 4
            && data.joinCode is string
            && data.joinedAt is int
            && data.updatedAt is int;
        }

        /** The DM role always belongs to the party's owner (after this request). */
        function roleMatchesOwner(role) {
          return (getAfter(partyPath(pid)).data.ownerUid == uid) == (role == 'dm');
        }

        allow read: if isMember(pid);

        allow create: if isOwner(uid)
          && validMember(request.resource.data)
          && usernameMatchesEmail(request.resource.data.username)
          && (
            // The creator, in the party-creation batch.
            (request.resource.data.role == 'dm'
              && getAfter(partyPath(pid)).data.ownerUid == uid)
            // A player with the current code, while joining is enabled.
            || (request.resource.data.role == 'player'
              && get(partyPath(pid)).data.joinEnabled == true
              && get(partyPath(pid)).data.joinCode == request.resource.data.joinCode)
          );

        allow update: if signedIn()
          && validMember(request.resource.data)
          && request.resource.data.username == resource.data.username
          && request.resource.data.joinCode == resource.data.joinCode
          && request.resource.data.joinedAt == resource.data.joinedAt
          && (
            // Own card: summary, sharing, character; the role only changes in an ownership transfer.
            (isOwner(uid)
              && (request.resource.data.role == resource.data.role || roleMatchesOwner(request.resource.data.role)))
            // The DM hands over the role: only `role` changes, and it must match the new owner.
            || (isPartyOwner(pid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
              && roleMatchesOwner(request.resource.data.role))
          );

        // Leaving (the owner only once the party is gone), or removal by the DM.
        allow delete: if (isOwner(uid)
            && (!existsAfter(partyPath(pid)) || getAfter(partyPath(pid)).data.ownerUid != uid))
          || (isPartyOwner(pid) && uid != request.auth.uid);
      }

      // The shared portrait of a member: one small image, readable by the party.
      match /members/{uid}/portrait/{doc} {
        function validSharedPortrait(data) {
          return data.keys().hasOnly(['schemaVersion', 'portrait', 'updatedAt'])
            && data.schemaVersion is int
            && data.portrait is string && data.portrait.size() <= 60000
            && data.portrait.matches('data:image/(jpeg|png|webp);base64,.*')
            && data.updatedAt is int;
        }

        allow read: if isMember(pid);
        allow create, update: if isOwner(uid) && isMember(pid) && doc == 'main' && validSharedPortrait(request.resource.data);
        // The owner takes it down; the DM can also remove it (and clears it when removing a member).
        allow delete: if isOwner(uid) || isPartyOwner(pid);
      }

      // The party's bestiary: creatures met in the campaign and what the group has learned about them.
      // Every member adds and fills it in; the author or the DM deletes an entry.
      match /bestiary/{entryId} {
        function validEntry(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'name', 'srdId', 'creatureType', 'place', 'notes', 'revealed', 'custom',
              'createdBy', 'createdByName', 'createdAt', 'updatedAt'])
            && data.schemaVersion is int
            && shortString(data.name, 80) && data.name.size() > 0
            && (data.srdId == null || shortString(data.srdId, 80))
            && shortString(data.creatureType, 40)
            && shortString(data.place, 100)
            && shortString(data.notes, 2000)
            && data.revealed is list && data.revealed.size() <= 14
            && data.custom is map && data.custom.size() <= 3
            && shortString(data.createdBy, 64)
            && shortString(data.createdByName, 60)
            && data.createdAt is int
            && data.updatedAt is int;
        }

        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && validEntry(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        // Name, SRD monster and author never change; the rest is for every member to fill in.
        allow update: if isMember(pid)
          && validEntry(request.resource.data)
          && request.resource.data.name == resource.data.name
          && request.resource.data.srdId == resource.data.srdId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isMember(pid) && (resource.data.createdBy == request.auth.uid || isPartyOwner(pid));
      }

      match /quests/{questId} {
        function validQuest(data) {
          return data.keys().hasOnly(['schemaVersion', 'title', 'description', 'status', 'updatedAt'])
            && data.schemaVersion is int
            && shortString(data.title, 100) && data.title.size() > 0
            && shortString(data.description, 2000)
            && data.status in ['active', 'completed', 'failed']
            && data.updatedAt is int;
        }

        allow read: if isMember(pid);
        allow create, update: if isPartyOwner(pid) && validQuest(request.resource.data);
        allow delete: if isPartyOwner(pid);
      }

      match /log/{entryId} {
        function validEntry(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'title', 'body', 'sessionDate', 'authorUid', 'authorName', 'createdAt', 'updatedAt'])
            && data.schemaVersion is int
            && shortString(data.title, 100) && data.title.size() > 0
            && shortString(data.body, 10000)
            && shortString(data.sessionDate, 10)
            && data.authorUid is string
            && shortString(data.authorName, 20)
            && data.createdAt is int
            && data.updatedAt is int;
        }

        allow read: if isMember(pid);
        allow create: if isMember(pid)
          && validEntry(request.resource.data)
          && request.resource.data.authorUid == request.auth.uid;
        allow update: if isMember(pid)
          && validEntry(request.resource.data)
          && request.resource.data.authorUid == resource.data.authorUid
          && request.resource.data.createdAt == resource.data.createdAt
          && (resource.data.authorUid == request.auth.uid || isPartyOwner(pid));
        allow delete: if resource.data.authorUid == request.auth.uid || isPartyOwner(pid);
      }

      // Party maps: created by the DM; every member adds pins, one document each.
      match /maps/{mapId} {
        function validMap(data) {
          return data.keys().hasOnly([
              'schemaVersion', 'name', 'parentId', 'fingerprint', 'width', 'height', 'createdBy', 'createdAt', 'updatedAt'])
            && data.schemaVersion is int
            && shortString(data.name, 60)
            && (data.parentId == null || shortString(data.parentId, 64))
            && data.fingerprint is string && data.fingerprint.size() == 32
            && data.width is int && data.height is int
            && data.createdBy is string
            && data.createdAt is int
            && data.updatedAt is int;
        }

        allow read: if isMember(pid);
        allow create, update: if isPartyOwner(pid) && validMap(request.resource.data);
        allow delete: if isPartyOwner(pid);

        match /pins/{pinId} {
          function validPin(data) {
            return data.keys().hasOnly([
                'schemaVersion', 'x', 'y', 'title', 'note', 'kind', 'linkMapId',
                'authorUid', 'authorName', 'createdAt', 'updatedAt'])
              && data.schemaVersion is int
              && data.x is number && data.x >= 0 && data.x <= 1
              && data.y is number && data.y >= 0 && data.y <= 1
              && shortString(data.title, 80)
              && shortString(data.note, 1000)
              && data.kind in ['place', 'city', 'quest', 'danger', 'note']
              && (data.linkMapId == null || shortString(data.linkMapId, 64))
              && data.authorUid is string
              && shortString(data.authorName, 20)
              && data.createdAt is int
              && data.updatedAt is int;
          }

          allow read: if isMember(pid);
          allow create: if isMember(pid)
            && validPin(request.resource.data)
            && request.resource.data.authorUid == request.auth.uid
            && exists(/databases/$(database)/documents/parties/$(pid)/maps/$(mapId));
          allow update: if isMember(pid)
            && validPin(request.resource.data)
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.createdAt == resource.data.createdAt
            && (resource.data.authorUid == request.auth.uid || isPartyOwner(pid));
          allow delete: if resource.data.authorUid == request.auth.uid || isPartyOwner(pid);
        }
      }
    }
  }
}
